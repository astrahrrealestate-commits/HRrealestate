#!/usr/bin/env bash
# EstateOS pre-commit: harness self-test when hooks change; fast quality tier once the toolchain exists.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
staged=$(git diff --cached --name-only)
if grep -q '^\.claude/hooks/' <<<"$staged"; then
  python3 -m unittest discover -s .claude/hooks/tests -q
fi
# block staged secrets files outright
if grep -E '(^|/)\.env(\..+)?$|\.pem$|service-account.*\.json$|client_secret.*\.json$' <<<"$staged" | grep -vq '\.env\.example$'; then
  echo "pre-commit: refusing to commit secret-looking file" >&2; exit 1
fi
if [ -f pyproject.toml ] && [ -x .venv/bin/python ] && grep -Eq '\.py$' <<<"$staged"; then
  make quick
fi
