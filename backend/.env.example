# Copy to .env (make setup does this). Never commit .env. Claude cannot read .env (denied by settings).
ENV=dev

# Local stack (docker/compose.yml) — non-default host port avoids clashing with local installs.
# DBOS stores workflow state in this same database (schema `dbos`).
DATABASE_URL=postgresql+psycopg://estateos:estateos@localhost:5433/estateos
API_PORT=8000

# Storage (S3-compatible, EU region)
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Observability
SENTRY_DSN=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# LLM
OPENAI_API_KEY=
# Groq Cloud key, for LLM_MODEL=groq:llama-3.3-70b-versatile (https://console.groq.com)
GROQ_API_KEY=
# Google AI Studio key, for LLM_MODEL=google-gla:gemini-2.5-flash (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
EMBEDDING_MODEL=fake  # openai:text-embedding-3-small or google-gla:gemini-embedding-001 (1024 dimensions); prod refuses fake
RAG_QUERY_REWRITE=true  # one small LLM call per question (keyword variants, HyDE, fact label)
RAG_RERANK=true  # listwise LLM rerank of the fused candidates
LLM_MODEL=fake  # Pydantic AI model string, e.g. openai:gpt-4.1-mini; prod refuses fake
# Model for the Super Agent concierge planner only (e.g. google-gla:gemini-2.5-flash); empty = use LLM_MODEL.
CONCIERGE_MODEL=
# Quality tier (proposer, draft research, Astra research, person memory; reasoning high); empty = use LLM_MODEL.
LLM_QUALITY_MODEL=
LLM_QUALITY_TIMEOUT_SEC=180
LLM_QUALITY_MAX_OUTPUT_TOKENS=16000
LLM_TIMEOUT_SEC=60
# Tried in order when LLM_MODEL answers an error (comma separated); a fallback whose key is unset is skipped.
LLM_FALLBACK_MODELS=
# LLM usage limits per company (UTC day/month). Empty = unlimited (default).
LLM_DAILY_BUDGET_USD=
LLM_MONTHLY_BUDGET_USD=
# Owner questions count toward global caps: set OWNER_QA_DAILY_CAP together with any global LLM_DAILY_CALLS_CAP.
# Limits are read at startup (settings are cached): a changed limit needs an API/worker restart.
LLM_DAILY_CALLS_CAP=
OWNER_QA_DAILY_CAP=
OWNER_QA_DAILY_BUDGET_USD=
# Super Agent plans per company per day (empty = unlimited)
CONCIERGE_DAILY_CAP=
CONCIERGE_DAILY_BUDGET_USD=
CONCIERGE_WORKER_CONCURRENCY=4    # Super Agent turns running at once per worker (the `concierge` queue)
LLM_MAX_OUTPUT_TOKENS=4000  # structural per-call cap, always on
OWNER_TEMPLATE_NAME=estateos_pending  # approved WhatsApp template that reopens the 24 h window
OWNER_TEMPLATE_LANGUAGE=en

# Dashboard (docs/superpowers/specs/2026-10-15-dashboard-super-agent-design.md). Prod refuses fake auth and a missing secret.
DASHBOARD_AUTH_PROVIDER=fake      # fake | google
# at least 32 random characters, signs the session cookie
DASHBOARD_SESSION_SECRET=
DASHBOARD_SESSION_TTL_MIN=480
DASHBOARD_TRUST_FORWARDED_FOR=false  # true only behind a proxy that overwrites X-Forwarded-For
# audience of the owner's Google ID token (DASHBOARD_AUTH_PROVIDER=google)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Origin of the SPA (where Google flows send the browser back) and the API callback of the owner login. Both must be
# the real https URLs in production; the localhost defaults are refused when ENV=prod.
FRONTEND_BASE_URL=http://localhost:3000
# Only when the SPA and the API are on sibling hosts (api.example.com / app.example.com): the shared parent, with a
# leading dot (.example.com), so the SPA sees the session cookie. Empty = host-only cookie.
DASHBOARD_COOKIE_DOMAIN=
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:8000/api/auth/login/google/callback
# Serve the SPA same-origin behind the reverse proxy (default). Only for a SPA on another origin: its exact origins,
# comma-separated (https://dash.example.com). '*' is refused. Empty = no CORS. See docs/dashboard-api.md.
DASHBOARD_CORS_ORIGINS=
# Send mode (companies.outbound_mode=send): tenant sends allowed per company and hour; above it the approval is blocked.
TENANT_SENDS_PER_HOUR=30

# Channels: providers default to fakes (no real accounts needed). Prod refuses fakes. See docs/go-live-channels.md.
WHATSAPP_PROVIDER=fake            # fake | cloud_api | 360dialog | sendzen
GMAIL_PROVIDER=fake               # fake | google
STORAGE_BACKEND=local             # local | memory | s3 (prod: s3)
STORAGE_LOCAL_DIR=.data/storage
DEV_SIGNING_DIR=.data/dev-keys

# Inbound verification (ingestion side)
# Meta app secret (cloud_api), 360dialog partner platform secret, or SendZen webhook secret
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# https://graph.facebook.com/v21.0 | https://waba-v2.360dialog.io | https://api.sendzen.io/v1
WHATSAPP_API_BASE_URL=
WHATSAPP_MEDIA_TOKENS={}          # JSON {"<phone_number_id>": "<token>"}; per number; read only by app.channels.registry
GMAIL_PUBSUB_AUDIENCE=
GMAIL_PUBSUB_SERVICE_ACCOUNT=
GMAIL_PUBSUB_TOPIC=
GMAIL_CREDENTIALS_FILE=

# Send credentials — read ONLY by app/sender/settings.py (SenderSettings)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
GMAIL_SEND_CREDENTIALS_FILE=
# Send mode only (companies.outbound_mode=send): a separate gmail.send + gmail.metadata token for tenant replies
# (make gmail-consent ... reply_send=1 writes gmail-reply-send.json). Not the compose token above.
GMAIL_REPLY_SEND_CREDENTIALS_FILE=

# `make live-check` only (export in the shell; see docs/go-live-channels.md):
# LIVE_GMAIL_MAILBOX, LIVE_WHATSAPP_OWNER, LIVE_WHATSAPP_MEDIA, LIVE_WHATSAPP_TEST_TO (owner number only)

# Quote checker (M11): where market prices come from. fake = deterministic offline prices; competitors | web need the
# paid search API chosen in ADR 0009. Prod refuses fake.
PRICE_SOURCE=fake
# Only for PRICE_SOURCE=web (ADR 0009): none = no search API connected yet; fake = recorded pages for dev. A real
# provider (Firecrawl / Tavily / Brave) adds one SearchClient and one value here, plus its key. Prod refuses none/fake.
PRICE_SEARCH_PROVIDER=none
# Hosts web prices may come from, comma-separated bare hosts (shop.example, subdomains included). Empty = any.
PRICE_ALLOWED_DOMAINS=
# Verdict thresholds, percent over the reference price: up to OK_PCT is ok, over ABOVE_MARKET_PCT above market, over
# WELL_ABOVE_PCT well above market.
FINANCE_OK_PCT=5
FINANCE_ABOVE_MARKET_PCT=15
FINANCE_WELL_ABOVE_PCT=30
FINANCE_LOW_RATIO=0.5             # a line under this share of the reference is flagged suspiciously low
FINANCE_LATE_DAYS=7               # a quote arriving this many days after the work counts as late
FINANCE_MIN_SAMPLES=3             # fewer market samples than this is not a reference price
FINANCE_VAT_RATE=0.21             # Dutch standard VAT, to compare quotes quoted incl or excl VAT
FINANCE_DAILY_LOOKUP_CAP=40       # market price lookups per company per day
# BRIXX data mirror (read-only). Defaults to the offline fake; prod refuses it. Put the per-user token only in your
# private .env, never in git. See docs/superpowers/specs/ (BRIXX data mirror).
# BRIXX_PROVIDER=fake                         # fake | api
# BRIXX_BASE_URL=https://mob.brixxonline.com/api/v1
# BRIXX_ENVIRONMENT=hrrealestate
# BRIXX_TOKEN=                                # per-user API token (secret)
# BRIXX_AUTH_SCHEME=bearer                    # bearer | raw
# BRIXX_SYNC_INTERVAL_MINUTES=15
# BRIXX_TIMEOUT_SEC=60

# Document filing (#9, ADR 0005): fake = in-process memory drive; google needs a drive.file token (make gmail-consent drive=1)
DRIVE_PROVIDER=fake
DRIVE_CREDENTIALS_FILE=
# Document intelligence (M10, ADR 0007): read attachment text (PDF, docx, scans via vision). false = metadata-only filing.
DOC_READ_CONTENT=true

# Ngrok tunnel token (https://dashboard.ngrok.com/get-started/your-authtoken)
NGROK_AUTHTOKEN=
