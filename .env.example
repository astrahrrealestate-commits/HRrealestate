# Copy to .env (make setup does this). Never commit .env. Claude cannot read .env (denied by settings).
ENV=dev

# Local stack (docker/compose.yml) — non-default host port avoids clashing with local installs.
# DBOS stores workflow state in this same database (schema `dbos`).
DATABASE_URL=postgresql+psycopg://estateos:estateos@localhost:5433/estateos
API_PORT=8000

# Storage (S3-compatible, EU region)
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Observability
SENTRY_DSN=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# LLM
OPENAI_API_KEY=
GEMINI_API_KEY=  # Google AI Studio key, for LLM_MODEL=google-gla:gemini-2.5-flash (testing)
LLM_MODEL=fake  # Pydantic AI model string, e.g. openai:gpt-4.1-mini; prod refuses fake
LLM_TIMEOUT_SEC=60
# LLM usage limits per company (UTC day/month). Empty = unlimited (default).
LLM_DAILY_BUDGET_USD=
LLM_MONTHLY_BUDGET_USD=
# Owner questions count toward global caps: set OWNER_QA_DAILY_CAP together with any global LLM_DAILY_CALLS_CAP.
# Limits are read at startup (settings are cached): a changed limit needs an API/worker restart.
LLM_DAILY_CALLS_CAP=
OWNER_QA_DAILY_CAP=
OWNER_QA_DAILY_BUDGET_USD=
LLM_MAX_OUTPUT_TOKENS=4000  # structural per-call cap, always on
OWNER_TEMPLATE_NAME=estateos_pending  # approved WhatsApp template that reopens the 24 h window
OWNER_TEMPLATE_LANGUAGE=en

# Dashboard (docs/superpowers/specs/2026-10-15-dashboard-super-agent-design.md). Prod refuses fake auth and a missing secret.
DASHBOARD_AUTH_PROVIDER=fake      # fake | google
DASHBOARD_SESSION_SECRET=         # at least 32 random characters, signs the session cookie
DASHBOARD_SESSION_TTL_MIN=480
GOOGLE_OAUTH_CLIENT_ID=           # audience of the owner's Google ID token (DASHBOARD_AUTH_PROVIDER=google)
# Send mode (companies.outbound_mode=send): tenant sends allowed per company and hour; above it the approval is blocked.
TENANT_SENDS_PER_HOUR=30

# Channels: providers default to fakes (no real accounts needed). Prod refuses fakes. See docs/go-live-channels.md.
WHATSAPP_PROVIDER=fake            # fake | cloud_api | 360dialog
GMAIL_PROVIDER=fake               # fake | google
STORAGE_BACKEND=local             # local | memory | s3 (prod: s3)
STORAGE_LOCAL_DIR=.data/storage
DEV_SIGNING_DIR=.data/dev-keys

# Inbound verification (ingestion side)
WHATSAPP_APP_SECRET=              # Meta app secret (cloud_api) or 360dialog partner platform secret
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_BASE_URL=            # https://graph.facebook.com/v21.0 | https://waba-v2.360dialog.io
WHATSAPP_MEDIA_TOKENS={}          # JSON {"<phone_number_id>": "<token>"}; per number; read only by app.channels.registry
GMAIL_PUBSUB_AUDIENCE=
GMAIL_PUBSUB_SERVICE_ACCOUNT=
GMAIL_PUBSUB_TOPIC=
GMAIL_CREDENTIALS_FILE=

# Send credentials — read ONLY by app/sender/settings.py (SenderSettings)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
GMAIL_SEND_CREDENTIALS_FILE=
# Send mode only (companies.outbound_mode=send): a separate gmail.send + gmail.metadata token for tenant replies
# (make gmail-consent ... reply_send=1 writes gmail-reply-send.json). Not the compose token above.
GMAIL_REPLY_SEND_CREDENTIALS_FILE=

# `make live-check` only (export in the shell; see docs/go-live-channels.md):
# LIVE_GMAIL_MAILBOX, LIVE_WHATSAPP_OWNER, LIVE_WHATSAPP_MEDIA, LIVE_WHATSAPP_TEST_TO (owner number only)

# Document filing (#9, ADR 0005): fake = in-process memory drive; google needs a drive.file token (make gmail-consent drive=1)
DRIVE_PROVIDER=fake
DRIVE_CREDENTIALS_FILE=
