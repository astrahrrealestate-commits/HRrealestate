# Copy to .env (make setup does this). Never commit .env. Claude cannot read .env (denied by settings).
ENV=dev

# Local stack (docker/compose.yml) — non-default host ports avoid clashing with local installs
DATABASE_URL=postgresql+psycopg://estateos:estateos@localhost:5433/estateos
REDIS_URL=redis://localhost:6380/0
API_PORT=8000

# Storage (S3-compatible, EU region)
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Observability
SENTRY_DSN=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# LLM
OPENAI_API_KEY=

# Inbound verification (ingestion side)
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
GMAIL_PUBSUB_AUDIENCE=

# Send credentials — read ONLY by app/sender/settings.py (SenderSettings)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
GMAIL_SEND_CREDENTIALS_FILE=
