    "schemas": {
      "ActionOut": {
        "properties": {
          "approval": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ApprovalOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "draft_version": {
            "title": "Draft Version",
            "type": "integer"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "payload": {
            "additionalProperties": true,
            "title": "Payload",
            "type": "object"
          },
          "rationale": {
            "title": "Rationale",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ActionStatus"
          },
          "type": {
            "$ref": "#/components/schemas/ActionType"
          }
        },
        "required": [
          "id",
          "type",
          "status",
          "draft_version",
          "rationale",
          "payload",
          "approval"
        ],
        "title": "ActionOut",
        "type": "object"
      },
      "ActionStatus": {
        "enum": [
          "proposed",
          "pending_approval",
          "approved",
          "rejected",
          "superseded",
          "executed",
          "failed",
          "exception",
          "paused"
        ],
        "title": "ActionStatus",
        "type": "string"
      },
      "ActionType": {
        "enum": [
          "reply_draft",
          "notify_owner",
          "create_reminder",
          "update_case_state",
          "request_contractor",
          "escalate"
        ],
        "title": "ActionType",
        "type": "string"
      },
      "ActivityItem": {
        "properties": {
          "action_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Action Id"
          },
          "at": {
            "format": "date-time",
            "title": "At",
            "type": "string"
          },
          "case_id": {
            "anyOf": [
              {
