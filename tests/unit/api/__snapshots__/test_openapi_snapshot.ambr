          "id",
          "at",
          "case_id",
          "action_id",
          "label"
        ],
        "title": "ActivityItem",
        "type": "object"
      },
      "AgentMessageIn": {
        "description": "`page`: what the open dashboard page shows. Its ids are validated and resolved server-side; its snapshot text\nis unverified display text (see docs/dashboard-api.md).",
        "properties": {
          "conversation_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          },
          "page": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PageContext"
              },
              {
                "type": "null"
              }
            ]
          },
          "text": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "AgentMessageIn",
        "type": "object"
