aws_region        = "eu-central-1"
aws_profile       = "estateos"
aws_account_id    = "830044626379"
project_name      = "estateos"
github_repository = "astrahrrealestate-commits/HRrealestate"

# Dedicated Stage VPC Subnets (10.10.0.0/16)
vpc_cidr                 = "10.10.0.0/16"
public_subnet_a_cidr     = "10.10.1.0/24"
public_subnet_b_cidr     = "10.10.2.0/24"
private_db_subnet_a_cidr = "10.10.21.0/24"
private_db_subnet_b_cidr = "10.10.22.0/24"

app_port      = 8000
frontend_port = 3000

# RDS Database (PostgreSQL 16)
db_engine_version        = "16.4"
db_instance_class        = "db.t3.micro"
db_allocated_storage     = 20
db_max_allocated_storage = 100
db_name                  = "estateos"
db_username              = "estateos"

# ALB & Routing
# certificate_arn = "arn:aws:acm:eu-central-1:830044626379:certificate/xxxx-xxxx-xxxx"
enable_frontend      = true
frontend_host_header = "stage.estateos.hrrealestate.nl, app-stage.estateos.hrrealestate.nl"
api_host_header      = "api-stage.estateos.hrrealestate.nl"

# ECS Task Sizing
api_cpu           = 512
api_memory        = 1024
api_desired_count = 1

worker_cpu           = 512
worker_memory        = 1024
worker_desired_count = 1

frontend_cpu           = 256
frontend_memory        = 512
frontend_desired_count = 1

# Nightly shutdown (21:00 UTC = 22:00 CET) and morning startup (06:00 UTC = 07:00 CET)
enable_stage_scheduler   = true
scheduler_stop_cron_utc  = "cron(0 21 * * ? *)"
scheduler_start_cron_utc = "cron(0 6 * * ? *)"

# Application URLs
frontend_base_url         = "https://stage.estateos.hrrealestate.nl"
google_login_redirect_uri = "https://api-stage.estateos.hrrealestate.nl/api/auth/login/google/callback"
dashboard_cors_origins    = "https://stage.estateos.hrrealestate.nl"
